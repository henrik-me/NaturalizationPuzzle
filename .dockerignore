# Git
.git
.gitignore

# IDE
.vs
.vscode
*.user
*.suo

# .NET build artifacts
**/bin/
**/obj/

# Node
**/node_modules/

# Test projects
tests/

# Dev server state
.servers/

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# Documentation & scripts
*.md
# Story Mode catalog Markdown ships as <EmbeddedResource> in the API DLL
# (see NaturalizationPuzzle.Api.csproj) — exempt it from the *.md exclusion
# so the Dockerfile's COPY content/ actually delivers the embedded resources.
!content/stories/*.md
*.bat
*.sln
servers.ps1
container-test.ps1

# SQLite databases (seeded at startup)
**/*.db
**/*.db-shm
**/*.db-wal

# OS files
Thumbs.db
.DS_Store
