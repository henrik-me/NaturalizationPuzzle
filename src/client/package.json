{
  "name": "naturalization-puzzle",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^22.19.19 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "size": "size-limit"
  },
  "size-limit": [
    {
      "name": "Initial JS (brotli)",
      "path": "dist/assets/index-*.js",
      "limit": "180 kB"
    },
    {
      "name": "Initial CSS (brotli)",
      "path": "dist/assets/index-*.css",
      "limit": "40 kB"
    }
  ],
  "dependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "tailwindcss": "^4.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "web-vitals": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "@size-limit/file": "^13.0.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "~22.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "proxy-agent": "8.0.2",
    "size-limit": "^12.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.9",
    "wait-on": "^9.0.10"
  },
  "overrides": {
    "@rollup/plugin-terser": {
      "serialize-javascript": "7.0.5"
    },
    "tmp": "0.2.7",
    "uuid": "11.1.1",
    "puppeteer-core@24": {
      "@puppeteer/browsers": "3.2.1"
    }
  }
}
