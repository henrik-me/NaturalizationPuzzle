; Enforce engines.node from package.json so installs fail fast on
; unsupported Node versions instead of merely warning. The accepted
; range (^22.13.0 || ^24.0.0) covers the even-numbered Node majors that
; are on the LTS track: Node 22 is the current Active LTS and Node 24
; is the next planned LTS (promoted from Current to LTS in 2026-10).
; Odd-numbered majors (Node 23, 25, ...) are not on the LTS track and
; are blocked here for the same reason the Docker image and dependabot
; config block them.
engine-strict=true
