; Enforce engines.node from package.json so installs fail fast on
; unsupported Node versions instead of merely warning. The accepted
; range (^22.13.0 || ^24.0.0) covers the even-numbered Node majors
; that are on the LTS track. Odd-numbered Node majors (23, 25, ...)
; are never promoted to LTS and are blocked here for the same reason
; the Docker image and dependabot config block them.
engine-strict=true
