; Enforce engines.node from package.json so installs fail fast on
; unsupported Node versions instead of merely warning. The accepted
; range (^22.13.0 || ^24.0.0) is intentionally limited to LTS majors;
; non-LTS majors (23, 25, ...) are blocked here for the same reason the
; Docker image and dependabot config block them.
engine-strict=true
